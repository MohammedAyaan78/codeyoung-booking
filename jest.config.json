{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/tests"],
  "moduleNameMapper": {
    "@codeyoung/shared": "<rootDir>/shared/src/index.ts"
  },
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "tsconfig": {
        "paths": {
          "@codeyoung/shared": ["./shared/src"]
        }
      }
    }]
  }
}
